---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Base title="About">
  <Breadcrumb items={[
    { label: 'Oblio Labs', href: '/' },
    { label: 'About' },
  ]} />

  <h1 class="mb-3">About</h1>
  <p class="text-text-muted mb-12 max-w-[560px]">
    A two-person lab working on catastrophic forgetting in fine-tuned language models.
  </p>

  <section class="mb-16">
    <h2 class="text-lg mb-4">The name</h2>
    <p class="text-text-muted leading-relaxed">
      <em>Oblìo</em> is Italian for <em>oblivion</em>; <em>oblìo catastrofico</em> is the standard
      rendering of catastrophic forgetting. We took the name from the effect itself: capability
      acquired earlier does not survive the training that comes later.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-lg mb-4">Team</h2>
    <div class="space-y-6">
      <div>
        <h3 class="font-sans text-base font-medium">Davide</h3>
        <p class="text-text-muted text-sm">Co-founder</p>
      </div>
      <div>
        <h3 class="font-sans text-base font-medium">Alessandro</h3>
        <p class="text-text-muted text-sm">Co-founder</p>
      </div>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-lg mb-4">What we do</h2>
    <p class="text-text-muted leading-relaxed">
      We take continual learning strategies built for full-parameter training and test whether they hold
      up on LoRA and QLoRA adapters. Most of the work is measurement: forgetting is easy to describe and
      hard to quantify.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-lg mb-4">Infrastructure</h2>
    <p class="text-text-muted mb-6">
      We develop and test on local hardware, and rent cloud capacity when a model needs to run in production.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border text-left">
            <th class="pb-3 font-mono font-medium text-text-muted">Machine</th>
            <th class="pb-3 font-mono font-medium text-text-muted">Specs</th>
            <th class="pb-3 font-mono font-medium text-text-muted">Use</th>
          </tr>
        </thead>
        <tbody class="text-text-muted">
          <tr class="border-b border-border">
            <td class="py-3">MacBook Pro M4 Pro</td>
            <td class="py-3">24 GB unified</td>
            <td class="py-3">Dev, prototyping, small inference</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3">MacBook Pro M5 Pro</td>
            <td class="py-3">48 GB unified</td>
            <td class="py-3">Medium inference, local experiments</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3">Workstation</td>
            <td class="py-3">NVIDIA RTX PRO 4000 Blackwell, 24 GB</td>
            <td class="py-3">Fine-tuning and inference on small models</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3">Workstation</td>
            <td class="py-3">NVIDIA RTX PRO 6000 Blackwell, 96 GB</td>
            <td class="py-3">QLoRA fine-tuning up to 70B, local inference</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3">Cloud</td>
            <td class="py-3">On-demand GPUs/TPUs</td>
            <td class="py-3">Production runs, rented as needed</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2 class="text-lg mb-4">Contact</h2>
    <p class="text-text-muted">
      Write to us at <a href="mailto:info@obliolabs.com">info@obliolabs.com</a>.
    </p>
  </section>
</Base>
