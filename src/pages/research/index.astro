---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Research">
  <Breadcrumb items={[
    { label: 'Oblio Labs', href: '/' },
    { label: 'Research' },
  ]} />

  <h1 class="mb-3">Research</h1>
  <p class="text-text-muted mb-12">
    Experiments and results from our work on catastrophic forgetting in fine-tuned models.
  </p>

  {posts.length > 0 ? (
    <div class="divide-y divide-border">
      {posts.map((post) => (
        <ResearchCard
          id={post.id}
          title={post.data.title}
          date={post.data.date}
          abstract={post.data.abstract}
          tags={post.data.tags}
        />
      ))}
    </div>
  ) : (
    <p class="text-text-muted">Nothing published yet.</p>
  )}
</Base>
