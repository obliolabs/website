---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Base title="Models">
  <Breadcrumb items={[
    { label: 'Oblio Labs', href: '/' },
    { label: 'Models' },
  ]} />

  <h1 class="mb-3">Models</h1>
  <p class="text-text-muted leading-relaxed max-w-[560px]">
    Nothing released yet. When we do release something it will be narrow: adapters trained with
    LoRA or QLoRA on open foundations, for one task each, with the benchmarks and the limitations
    attached. Until then the work lives in <a href="/research">research</a>.
  </p>
</Base>
